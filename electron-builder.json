{
  "appId": "com.udseen.editor",
  "productName": "Udseen Editor",
  "directories": {
    "output": "runpack"
  },
  "files": [
    "out/**/*",
    "dist/**/*"
  ],
  "extraResources": [
    {
      "from": "assets",
      "to": "assets",
      "filter": ["**/*"]
    },
    {
      "from": "LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "THIRD-PARTY-LICENSES",
      "to": "THIRD-PARTY-LICENSES"
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "resources/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Udseen Editor",
    "installerSidebar": null
  },
  "mac": {
    "target": "dmg",
    "icon": "resources/icon.icns"
  },
  "linux": {
    "target": "AppImage",
    "icon": "resources/icon.png"
  }
}
