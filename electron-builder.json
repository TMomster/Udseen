{
  "appId": "com.udseen.editor",
  "productName": "Udseen Editor",
  "directories": {
    "output": "release"
  },
  "files": [
    "out/**/*",
    "dist/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "resources/icon.ico"
  },
  "mac": {
    "target": "dmg",
    "icon": "resources/icon.icns"
  },
  "linux": {
    "target": "AppImage",
    "icon": "resources/icon.png"
  }
}
